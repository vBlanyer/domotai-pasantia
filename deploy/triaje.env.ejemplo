# EnvironmentFile de la unidad systemd del MDR (copiar a /etc/mdr/triaje.env y ajustar).
# NO poner secretos en claro aquí en producción: la clave del conector va en un vault (#9); este
# fichero solo apunta a su ruta. Permisos 0600, dueño triaje.

# --- Fuente e inventario del cliente ---
TRIAJE_ALERTS=/var/ossec/logs/alerts/alerts.json      # alerts.json del SIEM del cliente (se sigue con tail -F)
TRIAJE_PERFIL=prototipo/perfiles/bancario.yml          # perfil del cliente (inventario, redes, topología…)
TRIAJE_HALLAZGOS=run/postura.json                      # hallazgos de postura del auditor (Nmap)
TRIAJE_SALIDA=run/trazas-bancario.jsonl                # ruta FIJA de la traza: retoma estado al reiniciar (#4)
TRIAJE_WEB_PUERTO=8787                                  # visor + API + /healthz, solo en 127.0.0.1

# --- Conector SSH (plano de gestión de los dispositivos) ---
TRIAJE_SSH_MODO=clave                                  # producción: autenticación por clave (no contraseña)
TRIAJE_SSH_USUARIO=triaje
TRIAJE_SSH_CLAVE=/etc/mdr/claves/triaje                # clave privada (custodia por vault, #9)
TRIAJE_SSH_KNOWN_HOSTS=/etc/mdr/known_hosts            # host keys verificadas
TRIAJE_NODO_GESTION=                                   # nodo desde el que sale el SSH (vacío = local)

# --- Integridad de la traza (RF-09) ---
TRIAJE_TRAZA_CLAVE=                                    # HMAC de la cadena de hashes (secreto; vault)
TRIAJE_ANCLA=                                          # host:puerto del syslog del manager para anclar
