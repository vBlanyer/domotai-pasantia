# EnvironmentFile de la unidad systemd del MDR. Copiar a /etc/mdr/triaje.env (root:root, 0600) y ajustar.
#
# FORMATO: una variable por línea y los comentarios SIEMPRE en su propia línea. systemd no quita un
# comentario puesto al final de la línea: `X=valor   # nota` deja en X el texto «valor   # nota».
# Un valor con comillas dobles dentro (el JSON de operadores) va entre comillas simples.
#
# NO poner secretos en claro aquí si el cliente tiene un gestor de secretos (vault): que lo rellene él.

# --- Fuente e inventario del cliente ---
# alerts.json del SIEM del cliente, seguido con tail -F. Sin uso si se recibe por red (TRIAJE_ESCUCHAR).
TRIAJE_ALERTS=/var/ossec/logs/alerts/alerts.json
# Perfil del cliente: inventario, redes, topología y política de continuidad.
TRIAJE_PERFIL=/etc/mdr/perfil.yml
# Postura de los equipos (puertos abiertos). La escribe `mdr escanear`. Con {"nodos": {}} todo es caso
# gris: confianza 0,5, así que nada que dependa de la confianza se automatiza.
TRIAJE_HALLAZGOS=/var/lib/mdr/postura.json
# Ruta FIJA de la traza: al reiniciar, el MDR retoma de ella las contenciones activas. Junto a ella
# viven el resto de ficheros de estado (políticas, inventario operativo, Conectividad, watchlist).
TRIAJE_SALIDA=/var/lib/mdr/trazas-cliente.jsonl
# Visor + API + /healthz. Siempre en 127.0.0.1.
TRIAJE_WEB_PUERTO=8787

# --- Recibir del SIEM por red (opcional; sustituye a TRIAJE_ALERTS) ---
# Descomentar para escuchar en vez de seguir un fichero. TRIAJE_PERMITIR es obligatoria fuera de
# loopback: las IPs del SIEM, separadas por comas.
#TRIAJE_ESCUCHAR=0.0.0.0:6514
#TRIAJE_PERMITIR=10.0.0.5
#TRIAJE_TLS_CERT=/etc/mdr/tls/mdr.crt
#TRIAJE_TLS_CLAVE=/etc/mdr/tls/mdr.key
#TRIAJE_TLS_CA=/etc/mdr/tls/ca-siem.crt

# --- Conector SSH (plano de gestión de los dispositivos) ---
# directo = el SSH sale de este mismo equipo.
TRIAJE_SSH_MODO=directo
TRIAJE_SSH_USUARIO=triaje
# La clave la genera la consola (Conectividad) en esta ruta la primera vez. Debe ser escribible por
# el servicio: por eso vive en /var/lib/mdr y no en /etc (que la unidad monta en solo lectura).
TRIAJE_SSH_CLAVE=/var/lib/mdr/conector/clave
TRIAJE_SSH_KNOWN_HOSTS=/var/lib/mdr/conector/known_hosts

# --- Integridad de la traza ---
# HMAC de la cadena de la traza. Generar con: openssl rand -hex 32. Para VERIFICAR la traza hay que
# usar la MISMA clave; sin ella, una traza firmada se reporta «ALTERADA». No cambiarla nunca a mitad.
#TRIAJE_TRAZA_CLAVE=
# host:puerto del syslog del SIEM donde anclar la traza (detecta truncados).
#TRIAJE_ANCLA=

# --- Consola web: un token por persona ---
# Con esto la consola pide token y cada acción queda firmada con el nombre. Generar cada token con
# openssl rand -hex 24. Entre comillas simples.
#TRIAJE_CONSOLA_OPERADORES='{"<token-de-ana>":"ana","<token-de-leo>":"leo"}'

# --- Geolocalización ---
# Base de países, offline: DB-IP «IP to Country Lite» (CSV mensual, CC BY 4.0). Se instala con
# `mdr instalar-geoip <descargado.csv.gz>`. El nombre debe llevar «dbip»: así la consola muestra la
# atribución que exige su licencia. Sin base, los orígenes salen sin país.
TRIAJE_GEOIP=/var/lib/mdr/dbip-country-lite.csv.gz
# Organización (ASN) de cada IP: DB-IP «IP to ASN Lite», igual, con `mdr instalar-asn`.
TRIAJE_ASN=/var/lib/mdr/dbip-asn-lite.csv.gz

# --- Conectividad ---
# 1 apaga la vista Conectividad: solo se ve la configuración guardada; no prueba, no lee claves ni
# cambia nada. Útil fuera de los periodos de alta de equipos.
#TRIAJE_CONECTIVIDAD_DESACTIVADA=1

# --- Estado de servicios (opcional) ---
# Fichero JSONL que escribe el monitor de servicios del cliente: una línea por muestra, con la forma
# {"t": "2026-11-09T10:00:00Z", "estados": {"web01": "ok", "app01": "caido"}}. Se muestra la última.
# Tiene que poder leerlo el usuario triaje.
#TRIAJE_SALUD=/var/log/monitor/salud.jsonl
