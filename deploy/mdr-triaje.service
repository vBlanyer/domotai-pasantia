[Unit]
Description=MDR de triaje (refina las alertas del SIEM del cliente y contiene por SSH)
Documentation=file:///opt/mdr/documentacion/04-fase4-diseno-de-arquitectura/integracion-en-produccion.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=triaje
Group=triaje
WorkingDirectory=/opt/mdr
EnvironmentFile=/etc/mdr/triaje.env
ExecStart=/opt/mdr/deploy/arrancar-mdr.sh

# Resiliencia (#5): se reinicia SIEMPRE que el daemon termina, no solo ante error. Es un daemon
# perpetuo: si la fuente (tail) muere, python3 recibe EOF y sale 0, y `on-failure` NO lo reiniciaría
# (quedaría parado en silencio); `always` sí. Un `systemctl stop` explícito no dispara reinicio.
# Al reiniciar retoma su estado de la traza (#4). El healthcheck /healthz lo sondea un monitor local
# (el daemon liga solo a 127.0.0.1); ver deploy/README.md.
Restart=always
RestartSec=5

# Endurecimiento básico. El daemon solo lee el alerts.json y abre SSH de salida hacia el plano de
# gestión de los dispositivos; el privilegio real vive en el sudoers acotado del catálogo EN LOS
# NODOS OBJETIVO, no en esta máquina, así que el proceso no necesita privilegios nuevos aquí.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
