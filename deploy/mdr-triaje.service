[Unit]
Description=MDR de triaje (refina las alertas del SIEM del cliente y contiene por SSH)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=triaje
Group=triaje
WorkingDirectory=/opt/mdr
EnvironmentFile=/etc/mdr/triaje.env
ExecStart=/opt/mdr/deploy/arrancar-mdr.sh

# Se reinicia SIEMPRE que el servicio termina, no solo ante error: si la fuente de alertas se corta,
# el proceso sale limpio y `on-failure` lo dejaría parado en silencio. Un `systemctl stop` explícito
# no dispara reinicio. Al reiniciar, el MDR retoma de la traza las contenciones activas. La salud se
# consulta en http://127.0.0.1:8787/healthz desde el propio equipo.
Restart=always
RestartSec=5

# Endurecimiento básico. El daemon solo lee el alerts.json y abre SSH de salida hacia el plano de
# gestión de los dispositivos; el privilegio real vive en el sudoers acotado del catálogo EN LOS
# NODOS OBJETIVO, no en esta máquina, así que el proceso no necesita privilegios nuevos aquí.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
UMask=0077

# Estado escribible del servicio: /var/lib/mdr, propiedad de triaje y solo suyo. Ahí viven la traza,
# los ficheros operativos (políticas, inventario, Conectividad) y la clave del conector. El código en
# /opt/mdr es de root y el servicio no puede modificarlo; /etc queda en solo lectura (ProtectSystem).
StateDirectory=mdr
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
