
<!-- Reglas locales del banco para que Wazuh detecte, además de la fuerza bruta SSH, las otras
     familias que el motor de triaje ya soporta (familias.yml). Cada regla se etiqueta con el
     `group` que el adaptador (`prototipo/adaptador_wazuh.familia_de`) mapea a la familia. -->

<group name="local,syslog,sshd,">
  <!-- Reconocimiento: una conexión SSH sin banner válido (p. ej. nmap -sV o un barrido). El OpenSSH
       moderno lo registra como "banner exchange ... invalid format" o "Connection closed by ...",
       que ninguna regla de fábrica levanta. Se etiqueta 'recon' -> familia reconocimiento. -->
  <rule id="100200" level="6">
    <decoded_as>sshd</decoded_as>
    <match>banner exchange: Connection from|Did not receive identification string</match>
    <group>recon,</group>
    <description>sshd: conexion sin banner valido (posible escaneo/reconocimiento)</description>
    <!-- Sin técnica, la alerta llegaba «s/téc.» y el caso RECON no aparecía en la cobertura ATT&CK. -->
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>
</group>

<!-- servicio_expuesto (telnet): no necesita regla local. Una conexión al señuelo telnet
     (lab/banco/telnet_expuesto.py -> "connect from <ip> (<ip>)") la levanta la regla de FÁBRICA 5602
     (grupo 'telnetd', que el adaptador mapea a servicio_expuesto), con srcip vía el telnet decoder
     local (local_decoder_telnetd.xml). -->

<!-- explotacion_conocida (web, G4): firmas de ataque web contra el señuelo HTTP (servicio.py las
     registra en formato Apache combined, que Wazuh decodifica como `web-accesslog`). El SQLi ya lo
     levanta la regla de fábrica 31164; estas reglas locales cubren otras firmas realistas. Grupo
     'attack' -> el adaptador (familia_de) las mapea a explotacion_conocida -> amenaza enrutada.
     VALIDAR EN VIVO con el banco levantado (como todo caso vivo): si el decoder o el token no casan
     en tu versión de Wazuh, ajusta el <url> o usa <decoded_as>. -->
<group name="local,web,attack,">
  <rule id="100300" level="6">
    <decoded_as>web-accesslog</decoded_as>
    <url>etc/passwd</url>
    <group>attack,</group>
    <description>web: path traversal / LFI (lectura de ficheros del sistema)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>
  <rule id="100301" level="8">
    <decoded_as>web-accesslog</decoded_as>
    <url>jndi</url>
    <group>attack,</group>
    <description>web: Log4Shell (inyeccion JNDI)</description>
    <mitre>
      <id>T1190</id>
      <id>T1203</id>
    </mitre>
  </rule>
  <rule id="100302" level="6">
    <decoded_as>web-accesslog</decoded_as>
    <url>%3Bid|%3bid</url>
    <group>attack,</group>
    <description>web: inyeccion de comandos (;id)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>
</group>

<!-- integridad_fichero (FIM): el banco alimenta Wazuh por syslog (no corre el modulo syscheck por
     agente), asi que el ataque (lab/banco/demo.py:ataque_integridad_fichero) MODIFICA un fichero
     critico real y escribe una linea `ossec-fim[...]` en auth.log que el reenviador (canal auth)
     manda a Wazuh. program_name 'ossec-fim' + grupo 'syscheck' -> el adaptador (familia_de) lo mapea a
     integridad_fichero -> AISLAR_NODO (cuarentena en el borde), humano incondicional.
     VALIDAR EN VIVO con el banco levantado (como todo caso vivo). -->
<group name="local,syscheck,">
  <rule id="100400" level="7">
    <program_name>ossec-fim</program_name>
    <group>syscheck,</group>
    <description>FIM: cambio/checksum de un fichero critico (integridad de ficheros)</description>
    <mitre>
      <id>T1565</id>
      <id>T1070</id>
    </mitre>
  </rule>
</group>

<!-- denegacion_servicio (DoS/flood): el ataque (demo.py:ataque_denegacion_servicio) genera una
     rafaga modesta y escribe una linea `ossec-flood[...]` en auth.log. program_name 'ossec-flood' +
     grupo 'dos' -> el adaptador lo mapea a denegacion_servicio -> LIMITAR_BANDA (acotar banda,
     contencion gradual), humano. Requiere que el activo victima declare `interfaz` en el perfil
     (bancario.yml); si no, el MDR veta la cuarentena fail-closed. VALIDAR EN VIVO. -->
<group name="local,dos,">
  <rule id="100500" level="8">
    <program_name>ossec-flood</program_name>
    <group>dos,</group>
    <description>DoS: posible inundacion volumetrica (denegacion de servicio)</description>
    <mitre>
      <id>T1498</id>
      <id>T1499</id>
    </mitre>
  </rule>
</group>

<!-- acceso_consumado: el atacante YA entro = login EXITOSO desde una IP que venia fallando. Wazuh YA
     trae una regla de fabrica para esto: la 40112 "Multiple authentication failures followed by a
     success" (if_group authentication_success + if_matched_group authentication_failures +
     same_source_ip, con srcip y hostname). En vez de reinventar la correlacion (fragil: depende de
     que 5763 acumule 8 fallos), 100600 es HIJA de 40112 y solo le anade el grupo 'intrusion' (que el
     adaptador mapea a acceso_consumado -> MATAR_CONEXION sobre la IP origen) y la tecnica MITRE. Un
     login LEGITIMO (sin fallos previos de esa IP) no dispara 40112, asi que tampoco esto. Validado en
     vivo 19/10 (los fallos del ataque deben ir algo espaciados para que 5763->40112 acumulen). -->
<group name="local,syslog,sshd,">
  <rule id="100600" level="12">
    <if_sid>40112</if_sid>
    <group>intrusion,</group>
    <description>Intrusion: login exitoso tras multiples fallos de autenticacion (acceso consumado)</description>
    <mitre>
      <id>T1078</id>
      <id>T1021</id>
    </mitre>
  </rule>
</group>

<!-- exfiltracion / C2 (9ª familia): un activo interno conecta a un DESTINO malicioso conocido (match
     con la lista CDB/threat-intel del SIEM). El banco no enruta a Internet, asi que el ataque
     (demo.py:ataque_exfiltracion) inyecta el evento que un IDS/threat-intel levantaria con src (el host
     que baliza) y dst (el destino); el decoder local banco-ids-c2 saca srcip/dstip. program_name
     'ossec-ids' + grupo 'c2' -> el adaptador (familia_de) lo mapea a exfiltracion -> BLOQUEAR_DESTINO
     (bloquear el egreso al destino en el cortafuegos de borde), humano. VALIDAR EN VIVO. -->
<group name="local,ids,">
  <rule id="100700" level="12">
    <program_name>ossec-ids</program_name>
    <group>c2,</group>
    <description>C2/exfiltracion: conexion a un destino malicioso conocido (lista de amenazas)</description>
    <mitre>
      <id>T1071</id>
      <id>T1041</id>
    </mitre>
  </rule>
</group>

<!-- malware / rootkit (10ª familia): un VEREDICTO explicito de binario malicioso (VirusTotal, o un
     trojano de rootcheck). El ataque (demo.py:ataque_malware) no ejecuta malware real: crea un fichero
     senuelo e inyecta el veredicto `ossec-vt[...]` en auth.log. program_name 'ossec-vt' + grupo
     'virustotal' -> el adaptador lo mapea a malware -> AISLAR_NODO (cuarentena en el borde, reusa FIM),
     humano incondicional. Un rootcheck/SCA SIN veredicto de malware sigue siendo 'plataforma' (ruido).
     VALIDAR EN VIVO. -->
<group name="local,virustotal,">
  <rule id="100800" level="12">
    <program_name>ossec-vt</program_name>
    <group>virustotal,malware,</group>
    <description>Malware: binario malicioso detectado (VirusTotal/rootcheck)</description>
    <mitre>
      <id>T1014</id>
      <id>T1486</id>
    </mitre>
  </rule>
</group>

