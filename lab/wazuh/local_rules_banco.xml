
<!-- Reglas locales del banco para que Wazuh detecte, además de la fuerza bruta SSH, las otras
     familias que el motor de triaje ya soporta (familias.yml). Cada regla se etiqueta con el
     `group` que el adaptador (`prototipo/adaptador_wazuh.familia_de`) mapea a la familia. -->

<group name="local,syslog,sshd,">
  <!-- Reconocimiento: una conexión SSH sin banner válido (p. ej. nmap -sV o un barrido). El OpenSSH
       moderno lo registra como "banner exchange ... invalid format" o "Connection closed by ...",
       que ninguna regla de fábrica levanta. Se etiqueta 'recon' -> familia reconocimiento. -->
  <rule id="100200" level="6">
    <decoded_as>sshd</decoded_as>
    <match>banner exchange: Connection from|Did not receive identification string</match>
    <group>recon,</group>
    <description>sshd: conexion sin banner valido (posible escaneo/reconocimiento)</description>
    <!-- Sin técnica, la alerta llegaba «s/téc.» y el caso RECON no aparecía en la cobertura ATT&CK. -->
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>
</group>

<!-- servicio_expuesto (telnet): no necesita regla local. Una conexión al señuelo telnet
     (lab/banco/telnet_expuesto.py -> "connect from <ip> (<ip>)") la levanta la regla de FÁBRICA 5602
     (grupo 'telnetd', que el adaptador mapea a servicio_expuesto), con srcip vía el telnet decoder
     local (local_decoder_telnetd.xml). -->

<!-- explotacion_conocida (web, G4): firmas de ataque web contra el señuelo HTTP (servicio.py las
     registra en formato Apache combined, que Wazuh decodifica como `web-accesslog`). El SQLi ya lo
     levanta la regla de fábrica 31164; estas reglas locales cubren otras firmas realistas. Grupo
     'attack' -> el adaptador (familia_de) las mapea a explotacion_conocida -> amenaza enrutada.
     VALIDAR EN VIVO con el banco levantado (como todo caso vivo): si el decoder o el token no casan
     en tu versión de Wazuh, ajusta el <url> o usa <decoded_as>. -->
<group name="local,web,attack,">
  <rule id="100300" level="6">
    <decoded_as>web-accesslog</decoded_as>
    <url>etc/passwd</url>
    <group>attack,</group>
    <description>web: path traversal / LFI (lectura de ficheros del sistema)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>
  <rule id="100301" level="8">
    <decoded_as>web-accesslog</decoded_as>
    <url>jndi</url>
    <group>attack,</group>
    <description>web: Log4Shell (inyeccion JNDI)</description>
    <mitre>
      <id>T1190</id>
      <id>T1203</id>
    </mitre>
  </rule>
  <rule id="100302" level="6">
    <decoded_as>web-accesslog</decoded_as>
    <url>%3Bid|%3bid</url>
    <group>attack,</group>
    <description>web: inyeccion de comandos (;id)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>
</group>

