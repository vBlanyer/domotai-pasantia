# Variables del despliegue oficial del MDR en AWS. Copia este fichero a produccion.tfvars (git lo
# ignora: no lo subas), rellena los <rellenar> y aplica con:
#     tofu plan  -var-file=produccion.tfvars
#     tofu apply -var-file=produccion.tfvars
# Pasos completos, cuotas y costes: DESPLIEGUE.md y COSTES.md. Aquí no va ningún secreto: solo ARNs.

# --- Región, nombres y red ---
region              = "<rellenar>" # la región acordada con la empresa, p. ej. "eu-west-1"
proyecto            = "mdr-triaje" # prefijo de nombres y etiquetas
entorno             = "prod"       # etiqueta: demo, pruebas o prod
vpc_cidr            = "10.90.0.0/16"
subred_privada_cidr = "10.90.1.0/24"
subred_publica_cidr = "10.90.2.0/24" # solo se usa con egreso_bootstrap = true (aloja el NAT)

# Primer arranque: true crea un NAT para descargar (el daemon no sale a Internet nunca). Con false, el
# paquete y el perfil deben estar en S3 (s3://…) y la GPU no se puede activar.
egreso_bootstrap = false

# --- Instancia del MDR ---
mdr_tipo     = "t3.small" # sin GPU; el motor decide unas 565 alertas/s en un portátil
mdr_disco_gb = 20         # EBS cifrado de la traza (/var/lib/mdr)

# --- Qué se instala: el paquete del release, verificado por su huella ---
mdr_version        = "1.9.1"                                                            # >= 1.9.2 si se activa la GPU
mdr_paquete_url    = "s3://<bucket>/mdr-1.9.1.tar.gz"                                   # o vacío = el release de GitHub (necesita egreso)
mdr_paquete_sha256 = "7c686657021aba4041d6eede34808a08831b832534b151736a42c1022adda519" # sha256sum del paquete

# --- Perfil del cliente ---
perfil_url        = "s3://<bucket>/perfil.yml" # vacío = perfil mínimo para empezar con el asistente de red
red_cliente_cidrs = []                         # rangos para el perfil mínimo; vacío = la VPC

# --- Secretos (ARN completo de Secrets Manager; ver DESPLIEGUE.md, paso 2) ---
secreto_traza_arn      = "<rellenar: ARN de mdr/traza-clave>"
secreto_operadores_arn = "<rellenar: ARN de mdr/operadores>"
secretos_arns          = [] # otros secretos que el MDR deba poder leer (p. ej. la clave SSH del conector)

# --- Modelo de lenguaje en GPU (opcional: es el grueso del coste) ---
llm_habilitado      = false
llm_tipo            = "g4dn.xlarge"
llm_modelo_url      = "" # s3:// o https:// del .gguf del generador (obligatorio con GPU)
llm_modelo_sha256   = "" # su SHA-256
embed_modelo_url    = "" # s3:// o https:// del .gguf de bge-m3
embed_modelo_sha256 = "" # su SHA-256
llama_cpp_ref       = "b12445"
