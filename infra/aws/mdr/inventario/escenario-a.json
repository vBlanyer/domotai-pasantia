{
 "escenario": "A",
 "descripcion": "Con egreso para el primer arranque (NAT), paquete del release de GitHub, sin secretos ni GPU.",
 "recursos": [
  {
   "direccion": "aws_instance.mdr",
   "tipo": "aws_instance",
   "por_que": "El MDR (daemon y consola).",
   "config": {
    "instance_type": "t3.small",
    "associate_public_ip_address": false,
    "metadata_options": [
     {
      "http_tokens": "required"
     }
    ],
    "root_block_device": [
     {
      "volume_size": 12,
      "volume_type": "gp3",
      "encrypted": true
     }
    ],
    "user_data_replace_on_change": true,
    "user_data": "plantilla de arranque (templates/), comprobada en el simulacro y contra el emulador"
   }
  },
  {
   "direccion": "aws_volume_attachment.traza",
   "tipo": "aws_volume_attachment",
   "por_que": "Engancha el disco de la traza al MDR (destroy apaga antes de soltarlo).",
   "config": {
    "device_name": "/dev/sdf",
    "stop_instance_before_detaching": true
   }
  },
  {
   "direccion": "module.base.aws_ebs_volume.traza",
   "tipo": "aws_ebs_volume",
   "por_que": "Disco cifrado de la traza y del estado del MDR (/var/lib/mdr).",
   "config": {
    "size": 20,
    "type": "gp3",
    "encrypted": true
   }
  },
  {
   "direccion": "module.base.aws_eip.nat[0]",
   "tipo": "aws_eip",
   "por_que": "IP pública del NAT (solo con egreso).",
   "config": {
    "domain": "vpc"
   }
  },
  {
   "direccion": "module.base.aws_iam_instance_profile.instancia",
   "tipo": "aws_iam_instance_profile",
   "por_que": "Perfil que asocia el rol a la instancia del MDR.",
   "config": {}
  },
  {
   "direccion": "module.base.aws_iam_role.instancia",
   "tipo": "aws_iam_role",
   "por_que": "Rol del MDR.",
   "config": {}
  },
  {
   "direccion": "module.base.aws_iam_role_policy_attachment.ssm",
   "tipo": "aws_iam_role_policy_attachment",
   "por_que": "El MDR se gestiona por SSM.",
   "config": {
    "policy_arn": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
   }
  },
  {
   "direccion": "module.base.aws_internet_gateway.igw[0]",
   "tipo": "aws_internet_gateway",
   "por_que": "Salida a Internet de la subred pública (solo con egreso).",
   "config": {}
  },
  {
   "direccion": "module.base.aws_nat_gateway.nat[0]",
   "tipo": "aws_nat_gateway",
   "por_que": "NAT para que el primer arranque descargue paquetes (solo con egreso); se cobra mientras exista.",
   "config": {}
  },
  {
   "direccion": "module.base.aws_route.privada_egreso[0]",
   "tipo": "aws_route",
   "por_que": "Salida de la subred privada por el NAT: la usa el primer arranque, y queda mientras haya egreso.",
   "config": {
    "destination_cidr_block": "0.0.0.0/0"
   }
  },
  {
   "direccion": "module.base.aws_route_table.privada",
   "tipo": "aws_route_table",
   "por_que": "Rutas de la subred privada (sin salida a Internet salvo el NAT).",
   "config": {}
  },
  {
   "direccion": "module.base.aws_route_table.publica[0]",
   "tipo": "aws_route_table",
   "por_que": "Rutas de la subred pública hacia el internet gateway.",
   "config": {}
  },
  {
   "direccion": "module.base.aws_route_table_association.privada",
   "tipo": "aws_route_table_association",
   "por_que": "Asocia la subred privada a sus rutas.",
   "config": {}
  },
  {
   "direccion": "module.base.aws_route_table_association.publica[0]",
   "tipo": "aws_route_table_association",
   "por_que": "Asocia la subred pública a sus rutas.",
   "config": {}
  },
  {
   "direccion": "module.base.aws_security_group.endpoints",
   "tipo": "aws_security_group",
   "por_que": "Cortafuegos de los endpoints: 443 desde la VPC.",
   "config": {
    "description": "Endpoints VPC de interfaz (443 desde la VPC)",
    "ingress": [
     {
      "puertos": "443-443",
      "protocolo": "tcp",
      "origen": [
       "10.90.0.0/16"
      ],
      "descripcion": "HTTPS desde la VPC"
     }
    ],
    "egress": [
     {
      "puertos": "0-0",
      "protocolo": "-1",
      "origen": [
       "0.0.0.0/0"
      ],
      "descripcion": null
     }
    ]
   }
  },
  {
   "direccion": "module.base.aws_security_group.mdr",
   "tipo": "aws_security_group",
   "por_que": "Cortafuegos del MDR: sin entradas; salida libre.",
   "config": {
    "description": "MDR daemon + visor (sin ingreso publico)",
    "egress": [
     {
      "puertos": "0-0",
      "protocolo": "-1",
      "origen": [
       "0.0.0.0/0"
      ],
      "descripcion": "salida (LLM, endpoints VPC, plano de gestion del cliente via VPN)"
     }
    ]
   }
  },
  {
   "direccion": "module.base.aws_subnet.privada",
   "tipo": "aws_subnet",
   "por_que": "Subred sin IP pública donde viven las instancias.",
   "config": {
    "cidr_block": "10.90.1.0/24",
    "map_public_ip_on_launch": false
   }
  },
  {
   "direccion": "module.base.aws_subnet.publica[0]",
   "tipo": "aws_subnet",
   "por_que": "Subred pública que solo aloja el NAT del primer arranque.",
   "config": {
    "cidr_block": "10.90.2.0/24",
    "map_public_ip_on_launch": false
   }
  },
  {
   "direccion": "module.base.aws_vpc.main",
   "tipo": "aws_vpc",
   "por_que": "Red privada del MDR.",
   "config": {
    "cidr_block": "10.90.0.0/16",
    "enable_dns_support": true,
    "enable_dns_hostnames": true
   }
  },
  {
   "direccion": "module.base.aws_vpc_endpoint.s3",
   "tipo": "aws_vpc_endpoint",
   "por_que": "Endpoint de S3: paquete, perfil y modelos sin salir a Internet.",
   "config": {
    "service_name": "com.amazonaws.us-east-1.s3",
    "vpc_endpoint_type": "Gateway"
   }
  },
  {
   "direccion": "module.base.aws_vpc_endpoint.ssm[\"ec2messages\"]",
   "tipo": "aws_vpc_endpoint",
   "por_que": "Endpoints de SSM: el analista entra por túnel, sin puertos abiertos.",
   "config": {
    "service_name": "com.amazonaws.us-east-1.ec2messages",
    "vpc_endpoint_type": "Interface",
    "private_dns_enabled": true
   }
  },
  {
   "direccion": "module.base.aws_vpc_endpoint.ssm[\"ssm\"]",
   "tipo": "aws_vpc_endpoint",
   "por_que": "Endpoints de SSM: el analista entra por túnel, sin puertos abiertos.",
   "config": {
    "service_name": "com.amazonaws.us-east-1.ssm",
    "vpc_endpoint_type": "Interface",
    "private_dns_enabled": true
   }
  },
  {
   "direccion": "module.base.aws_vpc_endpoint.ssm[\"ssmmessages\"]",
   "tipo": "aws_vpc_endpoint",
   "por_que": "Endpoints de SSM: el analista entra por túnel, sin puertos abiertos.",
   "config": {
    "service_name": "com.amazonaws.us-east-1.ssmmessages",
    "vpc_endpoint_type": "Interface",
    "private_dns_enabled": true
   }
  }
 ]
}
