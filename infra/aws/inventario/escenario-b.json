{
 "escenario": "B",
 "descripcion": "Sin egreso: paquete en S3, los dos secretos en Secrets Manager; sin NAT ni GPU. El de producción recomendado.",
 "recursos": [
  {
   "direccion": "aws_ebs_volume.traza",
   "tipo": "aws_ebs_volume",
   "por_que": "Disco cifrado de la traza y del estado del MDR (/var/lib/mdr).",
   "config": {
    "size": 20,
    "type": "gp3",
    "encrypted": true
   }
  },
  {
   "direccion": "aws_iam_instance_profile.gpu",
   "tipo": "aws_iam_instance_profile",
   "por_que": "Perfil que asocia el rol de la GPU a su instancia. Se crea aunque no haya GPU (sin coste).",
   "config": {}
  },
  {
   "direccion": "aws_iam_instance_profile.instancia",
   "tipo": "aws_iam_instance_profile",
   "por_que": "Perfil que asocia el rol a la instancia del MDR.",
   "config": {}
  },
  {
   "direccion": "aws_iam_role.gpu",
   "tipo": "aws_iam_role",
   "por_que": "Rol propio de la GPU (sin acceso a los secretos del MDR). Se crea aunque no haya GPU (sin coste).",
   "config": {}
  },
  {
   "direccion": "aws_iam_role.instancia",
   "tipo": "aws_iam_role",
   "por_que": "Rol del MDR.",
   "config": {}
  },
  {
   "direccion": "aws_iam_role_policy.leer_s3[0]",
   "tipo": "aws_iam_role_policy",
   "por_que": "El MDR lee el paquete y el perfil de S3.",
   "config": {
    "name": "leer-paquete-y-perfil",
    "policy": [
     {
      "acciones": "s3:GetObject",
      "sobre": "arn:aws:s3:::mdr-prueba/mdr-1.9.1.tar.gz"
     }
    ]
   }
  },
  {
   "direccion": "aws_iam_role_policy.leer_secretos[0]",
   "tipo": "aws_iam_role_policy",
   "por_que": "El MDR lee la clave de la traza y los analistas.",
   "config": {
    "name": "leer-secretos",
    "policy": [
     {
      "acciones": "secretsmanager:GetSecretValue",
      "sobre": [
       "arn:aws:secretsmanager:us-east-1:000000000000:secret:mdr/traza-clave",
       "arn:aws:secretsmanager:us-east-1:000000000000:secret:mdr/operadores"
      ]
     }
    ]
   }
  },
  {
   "direccion": "aws_iam_role_policy_attachment.gpu_ssm",
   "tipo": "aws_iam_role_policy_attachment",
   "por_que": "La GPU se gestiona por SSM. Se crea aunque no haya GPU (sin coste).",
   "config": {
    "policy_arn": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
   }
  },
  {
   "direccion": "aws_iam_role_policy_attachment.ssm",
   "tipo": "aws_iam_role_policy_attachment",
   "por_que": "El MDR se gestiona por SSM.",
   "config": {
    "policy_arn": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
   }
  },
  {
   "direccion": "aws_instance.mdr",
   "tipo": "aws_instance",
   "por_que": "El MDR (daemon y consola).",
   "config": {
    "instance_type": "t3.small",
    "associate_public_ip_address": false,
    "metadata_options": [
     {
      "http_tokens": "required"
     }
    ],
    "root_block_device": [
     {
      "volume_size": 12,
      "volume_type": "gp3",
      "encrypted": true
     }
    ],
    "user_data_replace_on_change": true,
    "user_data": "plantilla de arranque (templates/), comprobada en el simulacro y contra el emulador"
   }
  },
  {
   "direccion": "aws_route_table.privada",
   "tipo": "aws_route_table",
   "por_que": "Rutas de la subred privada (sin salida a Internet salvo el NAT).",
   "config": {}
  },
  {
   "direccion": "aws_route_table_association.privada",
   "tipo": "aws_route_table_association",
   "por_que": "Asocia la subred privada a sus rutas.",
   "config": {}
  },
  {
   "direccion": "aws_security_group.endpoints",
   "tipo": "aws_security_group",
   "por_que": "Cortafuegos de los endpoints: 443 desde la VPC.",
   "config": {
    "description": "Endpoints VPC de interfaz (443 desde la VPC)",
    "ingress": [
     {
      "puertos": "443-443",
      "protocolo": "tcp",
      "origen": [
       "10.90.0.0/16"
      ],
      "descripcion": "HTTPS desde la VPC"
     }
    ],
    "egress": [
     {
      "puertos": "0-0",
      "protocolo": "-1",
      "origen": [
       "0.0.0.0/0"
      ],
      "descripcion": null
     }
    ]
   }
  },
  {
   "direccion": "aws_security_group.llm",
   "tipo": "aws_security_group",
   "por_que": "Cortafuegos de la GPU: solo el MDR entra, al 8080 y al 8082. Se crea aunque no haya GPU (sin coste).",
   "config": {
    "description": "LLM justificador (solo desde el MDR)",
    "ingress": [
     {
      "puertos": "8082-8082",
      "protocolo": "tcp",
      "origen": "un grupo de seguridad (ver la descripción)",
      "descripcion": "embedder bge-m3 del RAG desde el MDR"
     },
     {
      "puertos": "8080-8080",
      "protocolo": "tcp",
      "origen": "un grupo de seguridad (ver la descripción)",
      "descripcion": "generador (llama-server) desde el MDR"
     }
    ],
    "egress": [
     {
      "puertos": "0-0",
      "protocolo": "-1",
      "origen": [
       "0.0.0.0/0"
      ],
      "descripcion": null
     }
    ]
   }
  },
  {
   "direccion": "aws_security_group.mdr",
   "tipo": "aws_security_group",
   "por_que": "Cortafuegos del MDR: sin entradas; salida libre.",
   "config": {
    "description": "MDR daemon + visor (sin ingreso publico)",
    "egress": [
     {
      "puertos": "0-0",
      "protocolo": "-1",
      "origen": [
       "0.0.0.0/0"
      ],
      "descripcion": "salida (LLM, endpoints VPC, plano de gestion del cliente via VPN)"
     }
    ]
   }
  },
  {
   "direccion": "aws_subnet.privada",
   "tipo": "aws_subnet",
   "por_que": "Subred sin IP pública donde viven las instancias.",
   "config": {
    "cidr_block": "10.90.1.0/24",
    "map_public_ip_on_launch": false
   }
  },
  {
   "direccion": "aws_volume_attachment.traza",
   "tipo": "aws_volume_attachment",
   "por_que": "Engancha el disco de la traza al MDR (destroy apaga antes de soltarlo).",
   "config": {
    "device_name": "/dev/sdf",
    "stop_instance_before_detaching": true
   }
  },
  {
   "direccion": "aws_vpc.main",
   "tipo": "aws_vpc",
   "por_que": "Red privada del MDR.",
   "config": {
    "cidr_block": "10.90.0.0/16",
    "enable_dns_support": true,
    "enable_dns_hostnames": true
   }
  },
  {
   "direccion": "aws_vpc_endpoint.s3",
   "tipo": "aws_vpc_endpoint",
   "por_que": "Endpoint de S3: paquete, perfil y modelos sin salir a Internet.",
   "config": {
    "service_name": "com.amazonaws.us-east-1.s3",
    "vpc_endpoint_type": "Gateway"
   }
  },
  {
   "direccion": "aws_vpc_endpoint.secretsmanager[0]",
   "tipo": "aws_vpc_endpoint",
   "por_que": "Endpoint de Secrets Manager: el arranque lee los secretos sin Internet.",
   "config": {
    "service_name": "com.amazonaws.us-east-1.secretsmanager",
    "vpc_endpoint_type": "Interface",
    "private_dns_enabled": true
   }
  },
  {
   "direccion": "aws_vpc_endpoint.ssm[\"ec2messages\"]",
   "tipo": "aws_vpc_endpoint",
   "por_que": "Endpoints de SSM: el analista entra por túnel, sin puertos abiertos.",
   "config": {
    "service_name": "com.amazonaws.us-east-1.ec2messages",
    "vpc_endpoint_type": "Interface",
    "private_dns_enabled": true
   }
  },
  {
   "direccion": "aws_vpc_endpoint.ssm[\"ssm\"]",
   "tipo": "aws_vpc_endpoint",
   "por_que": "Endpoints de SSM: el analista entra por túnel, sin puertos abiertos.",
   "config": {
    "service_name": "com.amazonaws.us-east-1.ssm",
    "vpc_endpoint_type": "Interface",
    "private_dns_enabled": true
   }
  },
  {
   "direccion": "aws_vpc_endpoint.ssm[\"ssmmessages\"]",
   "tipo": "aws_vpc_endpoint",
   "por_que": "Endpoints de SSM: el analista entra por túnel, sin puertos abiertos.",
   "config": {
    "service_name": "com.amazonaws.us-east-1.ssmmessages",
    "vpc_endpoint_type": "Interface",
    "private_dns_enabled": true
   }
  }
 ]
}
