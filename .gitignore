# Directorios de ejecucion que genera containerlab
lab/**/clab-*/
lab/campañas/prueba-*/
lab/campañas/*/traza-*.jsonl
*.img
*.img.gz
*.drawio
get-docker.sh

# Marcadores de procedencia que anade Windows a los ficheros descargados
*:Zone.Identifier

# El plan de trabajo firmado (CCT-002-2026) NO se versiona: lleva cedulas,
# telefonos, correos personales y las firmas escaneadas del tutor academico y
# del tutor industrial. Este repositorio tiene remoto publico en GitHub, y esos
# datos son de terceros que no consintieron su publicacion. El documento se
# conserva en local y la documentacion lo cita como fuente externa.
/Blanyer*CCT-002-2026*.pdf

# Artefactos de Python
__pycache__/
*.pyc

# Artefactos de compilacion de LaTeX (el informe de la Fase 7).
# Se versionan solo las fuentes (.tex/.bib), las imagenes y el PDF final.
documentacion/report/*.aux
documentacion/report/*.bbl
documentacion/report/*.blg
documentacion/report/*.log
documentacion/report/*.out
documentacion/report/*.toc
documentacion/report/*.lof
documentacion/report/*.lot
documentacion/report/*.fls
documentacion/report/*.fdb_latexmk
documentacion/report/*.xdv
documentacion/report/*.synctex.gz

# Modelos de ML (grandes, se descargan aparte)
modelos/

# Fuentes crudas del corpus RAG (bundles STIX grandes, se descargan aparte).
# El corpus curado (corpus.jsonl) y el README de fuentes SI se versionan.
prototipo/corpus/fuentes/*.json

# Salidas transitorias de los ejemplos de CLI (COMO-PROBAR) — se regeneran a demanda
/salida.jsonl
/normalizado.jsonl
/incidentes.jsonl
/trazas-stream.jsonl
visor/node_modules
visor/dist
